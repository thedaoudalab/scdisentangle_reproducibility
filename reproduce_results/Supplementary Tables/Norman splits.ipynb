   "source": [
    "import json\n",
    "import pandas as pd\n",
    "\n",
    
    "# SUPPLEMENTARY TABLE 5 (tab-sep)\n",
    
    "with open('../Datasets/preprocessed_datasets/norman_splits_1.json') as f:\n",
    "    splits_1 = json.load(f)\n",
    "\n",
    "# Build: perturbation split number (1-indexed for the paper)\n",
    "rows = []\n",
    "for split_idx in sorted(splits_1.keys(), key=int):\n",
    "    for pert in splits_1[split_idx]['ood']:\n",
    "        rows.append({\n",
    "            'Double perturbation': pert,\n",
    "            'Split': int(split_idx) + 1  # 1-indexed\n",
    "        })\n",
    "\n",
    "df_comb = pd.DataFrame(rows).sort_values(['Split', 'Double perturbation']).reset_index(drop=True)\n",
    "\n",
    "df_comb.to_excel('supplementary_table_5.xlsx', index=False)\n",
    "\n",
    "# Verify: 128 unique perturbations across 13 splits\n",
    "n_unique = df_comb['Double perturbation'].nunique()\n",
    "n_total = len(df_comb)\n",
    "print(f\"Combinatorially-seen: {n_total} rows, {n_unique} unique perturbations, 13 splits\")\n",
    "\n",
    "# Check no perturbation appears in multiple splits\n",
    "dupes = df_comb[df_comb.duplicated(subset='Double perturbation', keep=False)]\n",
    "if len(dupes) > 0:\n",
    "    print(f\"  WARNING: {len(dupes)} duplicate entries:\")\n",
    "    print(dupes)\n",
    "else:\n",
    "    print(\"No duplicates")\n",
    "\n",
    "print()\n",
    "print(\"=\" * 60)\n",
    "print(\"SUPPLEMENTARY TABLE 5 (tab-sep)\")\n",
    "print(\"=\" * 60)\n",
    "print(\"Double perturbation\\tSplit\")\n",
    "for _, row in df_comb.iterrows():\n",
    "    print(f\"{row['Double perturbation']}\\t{row['Split']}\")\n"
   ]
